# PenTool application authentication
API_KEY=pentool-api-key
JWT_SECRET=change-this-secret
PENTOOL_HOST=0.0.0.0
PENTOOL_PORT=8000

# LLM provider. Examples:
# nvidia_nim, nvidia_nim_local, openai, openrouter, groq, together,
# deepseek, mistral, lm_studio, vllm, ollama, openai_compatible
LLM_PROVIDER=nvidia_nim
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.3-70b-instruct

# Optional callback address used by controlled exploit workflows
ATTACKER_IP=
